  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      min-height: 100vh;
      background: linear-gradient(135deg, #0b6b4f, #19a974);
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 450px;
      background: white;
      border-radius: 20px;
      padding: 30px 25px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
      text-align: center;
    }

    h1 {
      color: #0b6b4f;
      margin-bottom: 15px;
      font-size: 28px;
    }

    p {
      color: #555;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .step {
      display: none;
    }

    .step.active {
      display: block;
    }

    label {
      display: block;
      text-align: left;
      font-weight: bold;
      color: #333;
      margin: 15px 0 7px;
    }

    input,
    select {
      width: 100%;
      padding: 14px;
      border: 1px solid #ccc;
      border-radius: 10px;
      font-size: 16px;
      outline: none;
    }

    input:focus,
    select:focus {
      border-color: #0b6b4f;
    }

    button {
      width: 100%;
      border: none;
      border-radius: 10px;
      padding: 14px;
      margin-top: 18px;
      background: #0b6b4f;
      color: white;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      background: #09583f;
    }

    .back {
      background: #777;
    }

    .back:hover {
      background: #555;
    }

    .success {
      padding: 15px;
    }

    .success h2 {
      color: #0b6b4f;
      margin-bottom: 15px;
    }

